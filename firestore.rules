rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read:   if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read:   if request.auth.uid == resource.data.patientId || isAdmin();
      // All mutations now go through the /api/appointments Express API (Admin SDK, bypasses
      // these rules) so appointment-state-machine validation and sample-generation guards can
      // never be skipped via a direct client write. Previously `create` allowed any
      // authenticated patient to write their own appointment directly — that path (and the
      // unguarded self-cancel `update` path) is what made walk-in creation and safe
      // cancellation-after-collection impossible to enforce; removed as part of this refactor.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read:  if request.auth.uid == resource.data.patientId || isAdmin();
      allow write: if isAdmin();
    }

    // Samples are created/mutated exclusively via the Admin SDK (Express API), which
    // bypasses these rules — this block is defense-in-depth so intent is explicit rather
    // than relying on Firestore's default-deny for an unlisted collection.
    match /samples/{sampleId} {
      allow read:  if request.auth.uid == resource.data.patientId || isAdmin();
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /tests/{testId} {
      allow read, write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    // Email queue: patients/admin can write (enqueue), nobody can read from client
    // Only the Firebase Admin SDK (GitHub Actions service account) reads this collection
    match /mailQueue/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Email config (reminder hours, etc.) — admin writes, nobody reads from client
    match /config/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
