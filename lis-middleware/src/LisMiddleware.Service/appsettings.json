{
  "Listeners": {
    "Erba": {
      "Port": 5100,
      "Driver": "erba"
    },
    "Sysmex": {
      "Port": 5200,
      "Driver": "sysmex"
    }
  },
  "Api": {
    "UseFake": true,
    "BaseUrl": "https://asia-south1-celltalediagnostics-8f817.cloudfunctions.net",
    "Auth": {
      "Type": "bearer",
      "HeaderName": "Authorization",
      "Token": "REPLACE_WITH_LIS_API_KEY"
    },
    "OrderLookup": {
      "Method": "GET",
      "Path": "/api/lis/order/{sampleId}",
      "FieldMap": {
        "patientId":    "patientId",
        "name":         "name",
        "sex":          "gender",
        "age":          "age",
        "dateOfBirth":  "dob"
      }
    },
    "ResultUpload": {
      "Method": "POST",
      "Path": "/api/lis/results"
    },
    "TimeoutSeconds": 5
  },
  "Resilience": {
    "RetryCount": 5,
    "BackoffSeconds": 2,
    "ResultQueuePath": "C:\\ProgramData\\LisMiddleware\\queue",
    "RetryIntervalMs": 15000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
